{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sguzman/machinotheca/blob/main/ontology/schema/specimen.schema.json",
  "title": "Machinotheca public specimen manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "slug",
    "title",
    "scope",
    "ontology",
    "sources",
    "presentation",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^specimen:[a-z0-9-]+$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "scope": {
      "type": "string",
      "minLength": 20
    },
    "manufacturer": {
      "type": "string"
    },
    "revisions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "summary": {
      "type": "string"
    },
    "ontology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "version"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      }
    },
    "sources": {
      "type": "string",
      "minLength": 1
    },
    "unresolved": {
      "type": "string"
    },
    "guide": {
      "type": "string"
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_path",
        "part_binding_path",
        "views"
      ],
      "properties": {
        "scene_path": {
          "type": "string",
          "minLength": 1
        },
        "part_binding_path": {
          "type": "string",
          "minLength": 1
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "enum": [
        "published",
        "withdrawn"
      ]
    },
    "fidelity": {
      "type": "array",
      "items": {
        "enum": [
          "P0",
          "P1",
          "P2",
          "P3",
          "P4",
          "P5",
          "P6"
        ]
      },
      "uniqueItems": true
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
